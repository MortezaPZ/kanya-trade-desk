APP_HOST=127.0.0.1
APP_PORT=8787
APP_OPEN_BROWSER=false

# Local terminal (read-only). Leave blank to attach to an already-open terminal.
MT5_PATH=
MT5_PORTABLE=false

# AI market analysis. Fill these locally; never commit the real key.
# Choose `chat_completions` or `messages_v1` from the API protocol offered.
LLM_PROTOCOL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_AUTH_HEADER=
LLM_AUTH_PREFIX=
LLM_VERSION_HEADER=
LLM_API_VERSION=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200

WATCHLIST=XAUUSD,XAGUSD,XTIUSD,US30,NAS100,EURUSD,GBPUSD,BTCUSD,ETHUSD
DEFAULT_TIMEFRAMES=M15,H1,H4,D1
RISK_PER_TRADE_PCT=1.0
